{
  "_comment": "示例配置：不含任何真实密码。复制为 config.json 后填写；SMTP 密码优先用环境变量 SMTP_PASS。",

  "site": {
    "baseUrl": "https://leads.chromai.com",
    "loginPath": "/api/auth/login",
    "followupsPath": "/api/followups",
    "leadsPath": "/api/leads",
    "usersPath": "/api/users",
    "publicUrl": "https://leads.chromai.com/"
  },

  "admin": {
    "email": "yucui@chromai.com",
    "password": "填写管理员密码（建议留空并改用环境变量 ADMIN_PASS）"
  },

  "smtp": {
    "host": "smtp.exmail.qq.com",
    "port": 465,
    "secure": true,
    "user": "notify@chromai.com",
    "pass": "留空时自动读取环境变量 SMTP_PASS",
    "from": "科诺美线索提醒 <notify@chromai.com>"
  },

  "schedule": {
    "tz": "Asia/Shanghai",
    "windowStartHour": 9,
    "windowEndHour": 18,
    "workdays": [1, 2, 3, 4, 5],
    "holidays": []
  },

  "thresholds": {
    "stage2Hours": 48,
    "stage3Hours": 72
  },

  "hub": {
    "enabled": false,
    "url": "",
    "serviceKey": ""
  },

  "options": {
    "dryRun": false,
    "deepLink": false
  }
}
